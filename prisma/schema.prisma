// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth / perfis ----------

enum Role {
  ADMIN
  EQUIPE
  FREELANCER
  CLIENTE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EQUIPE)
  ativo        Boolean  @default(true)
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id])
  createdAt    DateTime @default(now())
}

// ---------- Catálogo ----------

enum TipoCobranca {
  PROJETO_UNICO
  RECORRENCIA_MENSAL
  LOCACAO_HORA
}

model Pilar {
  id       String    @id @default(cuid())
  nome     String
  ordem    Int       @default(0)
  ativo    Boolean   @default(true)
  servicos Servico[]
}

model Servico {
  id                String       @id @default(cuid())
  pilarId           String
  pilar             Pilar        @relation(fields: [pilarId], references: [id])
  nome              String
  tipoCobranca      TipoCobranca
  descricao         String?
  argumentacaoVenda String?
  objecoesComuns    String?
  ordem             Int          @default(0)
  ativo             Boolean      @default(true)

  planos    Plano[]
  adicionais Adicional[]
  etapasTemplate PipelineEtapaTemplate[]
  propostas Proposta[]
  projetos  Projeto[]
  modelosDocumento ModeloDocumento[]
  checklistTemplate ChecklistPreProducaoTemplate[]
}

model Plano {
  id         String   @id @default(cuid())
  servicoId  String
  servico    Servico  @relation(fields: [servicoId], references: [id])
  nome       String
  valorMin   Float?
  valorMax   Float?
  prazoDias  Int?
  prazoTexto String?
  entregas   String[] @default([])
  ordem      Int      @default(0)
  ativo      Boolean  @default(true)

  propostas Proposta[]
  projetos  Projeto[]
  templatesEquipe       TemplateEquipe[]
  templatesEquipamento  TemplateEquipamento[]
}

model Adicional {
  id          String   @id @default(cuid())
  servicoId   String
  servico     Servico  @relation(fields: [servicoId], references: [id])
  nome        String
  valor       Float?
  descricao   String?
  ativo       Boolean  @default(true)

  propostas PropostaAdicional[]
}

model PipelineEtapaTemplate {
  id        String  @id @default(cuid())
  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])
  nome      String
  ordem     Int     @default(0)
}

model ChecklistPreProducaoTemplate {
  id        String  @id @default(cuid())
  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  nome      String
  ordem     Int     @default(0)
}

// ---------- CRM ----------

enum StatusRelacionamento {
  LEAD
  ORCAMENTO_ENVIADO
  CLIENTE_ATIVO
  CLIENTE_RECORRENTE
}

model Cliente {
  id                   String               @id @default(cuid())
  nome                 String
  empresa              String?
  contato              String?
  email                String?
  telefone             String?
  origem               String?
  statusRelacionamento StatusRelacionamento @default(LEAD)
  notasInternas        String?
  createdAt            DateTime             @default(now())

  usuarios  User[]
  propostas Proposta[]
  projetos  Projeto[]
}

// ---------- Propostas ----------

enum StatusProposta {
  ENVIADA
  NEGOCIACAO
  APROVADA
  RECUSADA
}

model Proposta {
  id                String         @id @default(cuid())
  clienteId         String
  cliente           Cliente        @relation(fields: [clienteId], references: [id])
  servicoId         String
  servico           Servico        @relation(fields: [servicoId], references: [id])
  planoId           String
  plano             Plano          @relation(fields: [planoId], references: [id])
  valorProposto      Float
  prazoPropostoDias  Int?
  status            StatusProposta @default(ENVIADA)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  adicionais PropostaAdicional[]
  projeto    Projeto?
}

model PropostaAdicional {
  propostaId  String
  proposta    Proposta  @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  adicionalId String
  adicional   Adicional @relation(fields: [adicionalId], references: [id])

  @@id([propostaId, adicionalId])
}

// ---------- Projetos ----------

enum StatusGeralProjeto {
  ATIVO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusEntrega {
  EM_REVISAO
  APROVADA
  REPROVADA
}

enum StatusRecebimento {
  PENDENTE
  PAGO
  ATRASADO
}

model Projeto {
  id           String              @id @default(cuid())
  propostaId   String?             @unique
  proposta     Proposta?           @relation(fields: [propostaId], references: [id])
  clienteId    String
  cliente      Cliente             @relation(fields: [clienteId], references: [id])
  servicoId    String
  servico      Servico             @relation(fields: [servicoId], references: [id])
  planoId      String?
  plano        Plano?              @relation(fields: [planoId], references: [id])
  nome         String
  tipoCobranca TipoCobranca
  valor        Float
  prazoData    DateTime?
  avulso       Boolean             @default(false)
  statusGeral  StatusGeralProjeto  @default(ATIVO)
  cicloAtual   Int?
  createdAt    DateTime            @default(now())

  etapas       ProjetoEtapa[]
  entregas     Entrega[]
  recebimentos Recebimento[]
  custos       Custo[]
  alocacoesEquipamento AlocacaoEquipamento[]
  escalas              Escala[]
  documentos           Documento[]
  checklistItens       ChecklistPreProducaoItem[]
}

model ProjetoEtapa {
  id         String      @id @default(cuid())
  projetoId  String
  projeto    Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome       String
  ordem      Int         @default(0)
  status     StatusEtapa @default(PENDENTE)
  dataInicio DateTime?
  dataFim    DateTime?
}

model ChecklistPreProducaoItem {
  id        String  @id @default(cuid())
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome      String
  ordem     Int     @default(0)
  concluido Boolean @default(false)
}

model Entrega {
  id                String        @id @default(cuid())
  projetoId         String
  projeto           Projeto       @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  versao            Int
  link              String?
  status            StatusEntrega @default(EM_REVISAO)
  comentarioCliente String?
  createdAt         DateTime      @default(now())
}

// ---------- Financeiro ----------

model Recebimento {
  id            String            @id @default(cuid())
  projetoId     String
  projeto       Projeto           @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  valor         Float
  vencimento    DateTime
  status        StatusRecebimento @default(PENDENTE)
  formaPagamento String?
  dataPagamento DateTime?
}

model Custo {
  id        String  @id @default(cuid())
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  tipo      String
  descricao String?
  valor     Float

  escala Escala?
}

// ---------- Equipamentos ----------

enum StatusEquipamento {
  DISPONIVEL
  MANUTENCAO
}

model Equipamento {
  id          String            @id @default(cuid())
  nome        String
  categoria   String
  status      StatusEquipamento @default(DISPONIVEL)
  observacoes String?
  ativo       Boolean           @default(true)
  createdAt   DateTime          @default(now())

  alocacoes AlocacaoEquipamento[]
  templates TemplateEquipamento[]
}

model AlocacaoEquipamento {
  id                String      @id @default(cuid())
  equipamentoId     String
  equipamento       Equipamento @relation(fields: [equipamentoId], references: [id])
  projetoId         String
  projeto           Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  data              DateTime
  checklistSaida    Boolean     @default(false)
  checklistRetorno  Boolean     @default(false)
}

model TemplateEquipamento {
  id            String      @id @default(cuid())
  planoId       String
  plano         Plano       @relation(fields: [planoId], references: [id], onDelete: Cascade)
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])
}

// ---------- Equipe ----------

enum TipoProfissional {
  FIXO
  FREELANCER
}

model Profissional {
  id           String           @id @default(cuid())
  nome         String
  funcao       String
  tipo         TipoProfissional @default(FREELANCER)
  diariaPadrao Float?
  contato      String?
  email        String?
  observacoes  String?
  ativo        Boolean          @default(true)

  escalas Escala[]
}

model Escala {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  projetoId      String
  projeto        Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  funcao         String
  data           DateTime
  cache          Float?
  custoId        String?      @unique
  custo          Custo?       @relation(fields: [custoId], references: [id], onDelete: SetNull)
}

model TemplateEquipe {
  id         String @id @default(cuid())
  planoId    String
  plano      Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  funcao     String
  quantidade Int    @default(1)
}

// ---------- Documentos / assinatura ----------

enum TipoDocumento {
  CONTRATO
  TERMO_USO_IMAGEM
  BRIEFING
  OUTRO
}

enum StatusDocumento {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
}

model ModeloDocumento {
  id        String        @id @default(cuid())
  servicoId String
  servico   Servico       @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  tipo      TipoDocumento
  nome      String
  conteudo  String
  ativo     Boolean       @default(true)

  documentos Documento[]
}

model Documento {
  id                String           @id @default(cuid())
  projetoId         String
  projeto           Projeto          @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  modeloDocumentoId String?
  modeloDocumento   ModeloDocumento? @relation(fields: [modeloDocumentoId], references: [id])
  tipo              TipoDocumento
  nome              String
  conteudo          String?
  link              String?
  status            StatusDocumento  @default(RASCUNHO)
  assinanteNome     String?
  assinanteIp       String?
  assinadoEm        DateTime?
  createdAt         DateTime         @default(now())
}
