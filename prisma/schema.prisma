// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth / perfis ----------

enum Role {
  ADMIN
  EQUIPE
  FREELANCER
  CLIENTE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EQUIPE)
  ativo        Boolean  @default(true)
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id])
  createdAt    DateTime @default(now())

  // áreas liberadas pelo admin (chaves de lib/permissoes.ts); só vale quando
  // permissoesPersonalizadas é true — senão a pessoa usa o padrão do cargo
  permissoes               String[] @default([])
  permissoesPersonalizadas Boolean  @default(false)

  // assistentes guiados que a pessoa já viu (ex.: "calculadora"): abrem sozinhos só na primeira vez
  tutoriaisVistos String[] @default([])
}

// ---------- Catálogo ----------

enum TipoCobranca {
  PROJETO_UNICO
  RECORRENCIA_MENSAL
  LOCACAO_HORA
}

model Pilar {
  id       String    @id @default(cuid())
  nome     String
  ordem    Int       @default(0)
  ativo    Boolean   @default(true)
  servicos Servico[]
}

model Servico {
  id                String       @id @default(cuid())
  pilarId           String
  pilar             Pilar        @relation(fields: [pilarId], references: [id])
  nome              String
  tipoCobranca      TipoCobranca
  descricao         String?
  argumentacaoVenda String?
  objecoesComuns    String?
  ordem             Int          @default(0)
  ativo             Boolean      @default(true)

  planos            Plano[]
  adicionais        Adicional[]
  etapasTemplate    PipelineEtapaTemplate[]
  propostas         Proposta[]
  projetos          Projeto[]
  modelosDocumento  ModeloDocumento[]
  checklistTemplate ChecklistPreProducaoTemplate[]
}

model Plano {
  id         String   @id @default(cuid())
  servicoId  String
  servico    Servico  @relation(fields: [servicoId], references: [id])
  nome       String
  valorMin   Float?
  valorMax   Float?
  prazoDias  Int?
  prazoTexto String?
  entregas   String[] @default([])
  ordem      Int      @default(0)
  ativo      Boolean  @default(true)

  propostas            Proposta[]
  projetos             Projeto[]
  templatesEquipe      TemplateEquipe[]
  templatesEquipamento TemplateEquipamento[]
}

model Adicional {
  id        String  @id @default(cuid())
  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])
  nome      String
  valor     Float?
  descricao String?
  ativo     Boolean @default(true)

  propostas PropostaAdicional[]
}

model PipelineEtapaTemplate {
  id        String  @id @default(cuid())
  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id])
  nome      String
  ordem     Int     @default(0)
}

model ChecklistPreProducaoTemplate {
  id        String  @id @default(cuid())
  servicoId String
  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  nome      String
  ordem     Int     @default(0)
}

// ---------- CRM ----------

enum StatusRelacionamento {
  LEAD
  ORCAMENTO_ENVIADO
  CLIENTE_ATIVO
  CLIENTE_RECORRENTE
}

model Cliente {
  id                   String               @id @default(cuid())
  nome                 String
  empresa              String?
  contato              String?
  email                String?
  telefone             String?
  origem               String?
  statusRelacionamento StatusRelacionamento @default(LEAD)
  notasInternas        String?
  createdAt            DateTime             @default(now())

  usuarios  User[]
  propostas Proposta[]
  projetos  Projeto[]
}

// ---------- Propostas ----------

enum StatusProposta {
  ENVIADA
  NEGOCIACAO
  APROVADA
  RECUSADA
}

model Proposta {
  id                String         @id @default(cuid())
  clienteId         String
  cliente           Cliente        @relation(fields: [clienteId], references: [id])
  servicoId         String
  servico           Servico        @relation(fields: [servicoId], references: [id])
  planoId           String
  plano             Plano          @relation(fields: [planoId], references: [id])
  valorProposto     Float
  prazoPropostoDias Int?
  status            StatusProposta @default(ENVIADA)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  adicionais PropostaAdicional[]
  projeto    Projeto?

  @@index([status, updatedAt])
  @@index([clienteId])
}

model PropostaAdicional {
  propostaId  String
  proposta    Proposta  @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  adicionalId String
  adicional   Adicional @relation(fields: [adicionalId], references: [id])

  @@id([propostaId, adicionalId])
}

// ---------- Projetos ----------

enum StatusGeralProjeto {
  ATIVO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

enum StatusEtapa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum StatusEntrega {
  EM_REVISAO
  APROVADA
  REPROVADA
}

enum StatusRecebimento {
  PENDENTE
  PAGO
  ATRASADO
}

model Projeto {
  id           String             @id @default(cuid())
  propostaId   String?            @unique
  proposta     Proposta?          @relation(fields: [propostaId], references: [id])
  clienteId    String
  cliente      Cliente            @relation(fields: [clienteId], references: [id])
  servicoId    String
  servico      Servico            @relation(fields: [servicoId], references: [id])
  planoId      String?
  plano        Plano?             @relation(fields: [planoId], references: [id])
  nome         String
  tipoCobranca TipoCobranca
  valor        Float
  prazoData    DateTime?
  avulso       Boolean            @default(false)
  statusGeral  StatusGeralProjeto @default(ATIVO)
  cicloAtual   Int?
  createdAt    DateTime           @default(now())

  etapas               ProjetoEtapa[]
  entregas             Entrega[]
  recebimentos         Recebimento[]
  custos               Custo[]
  alocacoesEquipamento AlocacaoEquipamento[]
  escalas              Escala[]
  documentos           Documento[]
  checklistItens       ChecklistPreProducaoItem[]

  @@index([statusGeral, prazoData])
  @@index([clienteId])
  @@index([servicoId])
}

model ProjetoEtapa {
  id         String      @id @default(cuid())
  projetoId  String
  projeto    Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome       String
  ordem      Int         @default(0)
  status     StatusEtapa @default(PENDENTE)
  dataInicio DateTime?
  dataFim    DateTime?
}

model ChecklistPreProducaoItem {
  id        String  @id @default(cuid())
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome      String
  ordem     Int     @default(0)
  concluido Boolean @default(false)

  @@index([projetoId])
}

model Entrega {
  id                String        @id @default(cuid())
  projetoId         String
  projeto           Projeto       @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  versao            Int
  link              String?
  status            StatusEntrega @default(EM_REVISAO)
  comentarioCliente String?
  createdAt         DateTime      @default(now())

  @@index([projetoId])
}

// ---------- Financeiro ----------

model Recebimento {
  id             String            @id @default(cuid())
  projetoId      String
  projeto        Projeto           @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  valor          Float
  vencimento     DateTime
  status         StatusRecebimento @default(PENDENTE)
  formaPagamento String?
  dataPagamento  DateTime?

  @@index([status, vencimento])
  @@index([projetoId])
}

model Custo {
  id           String    @id @default(cuid())
  projetoId    String
  projeto      Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  tipo         String
  descricao    String?
  valor        Float
  dataPrevista DateTime?

  escala Escala?

  @@index([dataPrevista])
  @@index([projetoId])
}

// ---------- Equipamentos ----------

enum StatusEquipamento {
  DISPONIVEL
  MANUTENCAO
  // quebrado, sem previsão de volta: não conta na depreciação nem nos kits da calculadora
  ESTRAGADO
}

model Equipamento {
  id          String            @id @default(cuid())
  nome        String
  categoria   String
  status      StatusEquipamento @default(DISPONIVEL)
  observacoes String?
  foto        String?
  ativo       Boolean           @default(true)
  createdAt   DateTime          @default(now())

  // entram na depreciação da calculadora de custo/hora (/calculadora)
  valorCompra   Float?
  vidaUtilMeses Int?

  alocacoes   AlocacaoEquipamento[]
  templates   TemplateEquipamento[]
  fotoArquivo EquipamentoFoto?
  kits        KitEquipamentoItem[]
}

// fotos enviadas pelo sistema ficam no banco (e não em disco) para funcionar
// em qualquer host — inclusive com disco efêmero — e entrar no backup do banco.
// Fica numa tabela à parte para não pesar nas listagens de equipamento.
model EquipamentoFoto {
  equipamentoId String      @id
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  tipo          String
  dados         Bytes
}

model AlocacaoEquipamento {
  id               String      @id @default(cuid())
  equipamentoId    String
  equipamento      Equipamento @relation(fields: [equipamentoId], references: [id])
  projetoId        String
  projeto          Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  data             DateTime
  checklistSaida   Boolean     @default(false)
  checklistRetorno Boolean     @default(false)

  @@index([equipamentoId])
  @@index([projetoId])
}

model TemplateEquipamento {
  id            String      @id @default(cuid())
  planoId       String
  plano         Plano       @relation(fields: [planoId], references: [id], onDelete: Cascade)
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])
}

// ---------- Equipe ----------

enum TipoProfissional {
  FIXO
  FREELANCER
}

model Profissional {
  id            String           @id @default(cuid())
  nome          String
  funcao        String
  tipo          TipoProfissional @default(FREELANCER)
  diariaPadrao  Float?
  contato       String?
  email         String?
  observacoes   String?
  ativo         Boolean          @default(true)
  // só para tipo FIXO: entra na folha da calculadora de custo/hora
  salarioMensal Float?

  escalas Escala[]
}

model Escala {
  id             String       @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  projetoId      String
  projeto        Projeto      @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  funcao         String
  data           DateTime
  cache          Float?
  custoId        String?      @unique
  custo          Custo?       @relation(fields: [custoId], references: [id], onDelete: SetNull)

  @@index([profissionalId])
  @@index([projetoId])
}

model TemplateEquipe {
  id         String @id @default(cuid())
  planoId    String
  plano      Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  funcao     String
  quantidade Int    @default(1)
}

// ---------- Documentos / assinatura ----------

enum TipoDocumento {
  CONTRATO
  TERMO_USO_IMAGEM
  BRIEFING
  OUTRO
}

enum StatusDocumento {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
}

model ModeloDocumento {
  id        String        @id @default(cuid())
  servicoId String
  servico   Servico       @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  tipo      TipoDocumento
  nome      String
  conteudo  String
  ativo     Boolean       @default(true)

  documentos Documento[]
}

model Documento {
  id                String           @id @default(cuid())
  projetoId         String
  projeto           Projeto          @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  modeloDocumentoId String?
  modeloDocumento   ModeloDocumento? @relation(fields: [modeloDocumentoId], references: [id])
  tipo              TipoDocumento
  nome              String
  conteudo          String?
  link              String?
  status            StatusDocumento  @default(RASCUNHO)
  assinanteNome     String?
  assinanteIp       String?
  assinadoEm        DateTime?
  createdAt         DateTime         @default(now())

  @@index([projetoId])
}

// ---------- Calculadora de custo/hora ----------

// custos recorrentes da agência (energia, água, internet, aluguel, tráfego pago...).
// O valor é uma média mensal — não precisa ser a conta exata.
model CustoFixo {
  id          String   @id @default(cuid())
  nome        String
  categoria   String
  valorMensal Float
  ativo       Boolean  @default(true)
  // a quem o custo pertence: "YANG" entra inteiro na hora da produtora; "COMPARTILHADO"
  // (serve a YANG e ao perfil Yan Maximiano) entra pelo rateio da config; "PESSOAL" não entra.
  escopo      String   @default("YANG")
  // sai do aporte do investidor (orçamento de lançamento)?
  doAporte    Boolean  @default(false)
  createdAt   DateTime @default(now())

  meses CustoFixoMes[]
}

// valor de um custo fixo num mês específico ("2026-10"), quando difere do
// valorMensal padrão (ex.: salário que sobe mês a mês, pró-labore reduzido).
model CustoFixoMes {
  custoFixoId String
  custoFixo   CustoFixo @relation(fields: [custoFixoId], references: [id], onDelete: Cascade)
  mes         String
  valor       Float

  @@id([custoFixoId, mes])
}

// parâmetros da calculadora; existe no máximo uma linha (id "singleton").
// Sem a linha, valem os padrões de lib/calculadora.ts.
model ConfigCalculadora {
  id                String   @id @default("singleton")
  horasMensais      Float    @default(176)
  pessoasFaturaveis Int      @default(1)
  ocupacaoPct       Float    @default(75)
  impostoPct        Float    @default(6)
  margemPct         Float    @default(30)
  comissaoPct       Float    @default(10)
  rateioYangPct     Float    @default(50)
  ticketCasamento   Float    @default(4500)
  aporteTotal       Float    @default(0)
  aporteInicio      String   @default("2026-10")
  aporteMeses       Int      @default(3)
  diasUsoMes        Float    @default(8)
  encargosPct       Float    @default(0)
  depreciacaoPct    Float    @default(1.6)
  precoCombustivel  Float    @default(6.2)
  consumoKmL        Float    @default(10)
  desgasteKm        Float    @default(0.25)
  alimentacaoDia    Float    @default(60)
  diariaHospedagem  Float    @default(200)
  atualizadoEm      DateTime @updatedAt

  // listas e faixas que o usuário ajusta na tela (valores padrão em lib/calculadora.ts)
  categoriasCusto            String[] @default(["Salários", "Pró-labore", "Aluguel", "Energia", "Água", "Internet e telefone", "Software e assinaturas", "Tráfego pago", "Terceirizados recorrentes", "Contabilidade", "Identidade visual", "Reserva de caixa", "Marketing", "Veículo (seguro, IPVA)", "Outros"])
  margensComparacao          Float[]  @default([10, 20, 30, 40, 50])
  rateiosComparacao          Float[]  @default([50, 75, 100])
  taxasDepreciacaoComparacao Float[]  @default([1, 1.6, 2, 2.8])
  faixasMargemNomes          String[] @default(["Apertado", "Baixo", "Saudável", "Ótimo"])
  faixasMargemLimites        Float[]  @default([10, 20, 30])
  mesesNaProjecao            Int      @default(6)
  rotulosEscopo              String[] @default(["YANG (produtora)", "Compartilhado (YANG + perfil Yan)", "Só perfil / infoprodutos"])
}

// quem gera horas cobráveis para a YANG. Cada pessoa entra com horas/mês, ocupação e
// escopo: o escopo vale para as horas o mesmo que vale para os custos (compartilhado
// = só o rateio da config das horas dessa pessoa conta para a YANG).
model PessoaHoras {
  id          String   @id @default(cuid())
  nome        String
  funcao      String?
  horasMes    Float    @default(176)
  ocupacaoPct Float    @default(75)
  escopo      String   @default("COMPARTILHADO")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// conjuntos de equipamentos que costumam sair juntos (ex.: kit leve de conteúdo).
// No simulador, aplicar um kit marca todos os itens de uma vez.
model KitEquipamento {
  id        String               @id @default(cuid())
  nome      String
  createdAt DateTime             @default(now())
  itens     KitEquipamentoItem[]
}

model KitEquipamentoItem {
  kitId         String
  kit           KitEquipamento @relation(fields: [kitId], references: [id], onDelete: Cascade)
  equipamentoId String
  equipamento   Equipamento    @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@id([kitId, equipamentoId])
}
