# Copie este arquivo para ".env" (local) ou cadastre estas variáveis no painel da
# hospedagem. NUNCA commite o .env real.

# Conexão PostgreSQL (14+). Se a hospedagem exigir SSL, termine com ?sslmode=require
DATABASE_URL="postgres://usuario:senha@host:5432/yang"

# Segredo que assina os logins. Gere um valor novo para cada ambiente:
#   openssl rand -base64 32
AUTH_SECRET=""

# Usados só por `npm run db:seed` para criar o PRIMEIRO administrador (ignorados se
# já existir um ADMIN). Depois de logar, troque a senha em "Alterar minha senha" (/conta).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
